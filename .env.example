# The public https:// address of the published website (no trailing path).
# The QR code encodes  <this value>/menu
# Set it to your real production domain before printing any QR codes.
# If you leave it empty, the QR code uses the address the site is currently
# being viewed on, and refuses to generate a code for localhost / local IPs.
NEXT_PUBLIC_SITE_URL=https://your-restaurant-domain.com

# Optional: load the menu from a different JSON file (e.g. one hosted on a CDN
# or in cloud storage) so the menu can be updated without redeploying the site.
# Must be a URL that allows cross-origin (CORS) reads. Defaults to /data/menu.json
# NEXT_PUBLIC_MENU_DATA_URL=https://example.com/mamas-kitchen/menu.json
